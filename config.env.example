# Copy to config.env (gitignored) and fill in. Sourced by bin/standup-daily.sh
# and bin/email-tasks.sh.

# Which agent runs the morning workflows: claude | copilot
AGENT=claude
# Binaries, if not on the launchd PATH.
#CLAUDE_BIN="$HOME/.local/bin/claude"
#COPILOT_BIN="/opt/homebrew/bin/copilot"

# Jira host, name only. Used to check the VPN is up before running anything.
JIRA_HOST=jira.example.com

# Shown in the Dashboard banner when Jira says 401/403, so you know what to run.
AUTH_CMD="node $HOME/Projects/raven/packages/auth/dist/cli.js"   # RAVEN's Jira login; named in the Dashboard banner when the session has expired

# Optional. Folder where your mail automation drops one JSON file per flagged
# email (see bin/email-tasks.sh). Leave unset to skip the email step.
#MAIL_DIR="$HOME/Library/CloudStorage/OneDrive-YourOrg/Workflow-mail"
